tmpFont.zip
.fonts
tmpFont.zip
.secrets
**/.bin
nvim/nvim-mason-install-configuration.json
nushell/history.txt

# machine-local overrides (never committed)
.zshenv.local
.zshrc.local
*.local.zsh

# decrypted secrets must never land in the repo
secrets/*.env
!secrets/*.sops.env
secrets/*.dec.*
*.age.key
keys.txt

# herdr runtime state (the whole herdr/ dir is symlinked to ~/.config/herdr)
herdr/*.log
herdr/*.sock
herdr/session.json
herdr/session-snapshots/

# yazi runtime state
yazi/plugins/*/
!yazi/plugins/.gitkeep
