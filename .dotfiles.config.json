{
  // Read by `envmgr dotfiles link` (https://github.com/dev-vinicius-andrade/environment-manager#dotfiles).
  // Hyprland is left out on purpose: link it by hand on a machine that runs it.
  // "os" uses Go names: linux (incl. WSL), darwin, windows. Omit it for all.
  "links": [
    // shells (zsh on Linux/macOS/WSL; PowerShell on Windows)
    { "src": ".zshenv", "dest": "~/.zshenv", "os": ["linux", "darwin"] },
    { "src": ".zshrc", "dest": "~/.zshrc", "os": ["linux", "darwin"] },
    { "src": "powershell/profile.ps1", "dest": "~/Documents/PowerShell/Microsoft.PowerShell_profile.ps1", "os": ["windows"] },

    // same path on every OS
    { "src": "starship/starship.toml", "dest": "~/.config/starship.toml" },
    { "src": "atuin/config.toml", "dest": "~/.config/atuin/config.toml" },
    { "src": "wezterm", "dest": "~/.config/wezterm" },

    // neovim
    { "src": "nvim", "dest": "~/.config/nvim", "os": ["linux", "darwin"] },
    { "src": "nvim", "dest": "~/AppData/Local/nvim", "os": ["windows"] },

    // yazi
    { "src": "yazi", "dest": "~/.config/yazi", "os": ["linux", "darwin"] },
    { "src": "yazi", "dest": "~/AppData/Roaming/yazi/config", "os": ["windows"] },

    // alacritty / nushell
    { "src": "alacritty", "dest": "~/.config/alacritty", "os": ["linux", "darwin"] },
    { "src": "alacritty", "dest": "~/AppData/Roaming/alacritty", "os": ["windows"] },
    { "src": "nushell", "dest": "~/.config/nushell", "os": ["linux"] },
    { "src": "nushell", "dest": "~/Library/Application Support/nushell", "os": ["darwin"] },
    { "src": "nushell", "dest": "~/AppData/Roaming/nushell", "os": ["windows"] },

    // unix-only tools
    { "src": "herdr", "dest": "~/.config/herdr", "os": ["linux", "darwin"] },
    { "src": "zellij", "dest": "~/.config/zellij", "os": ["linux", "darwin"] }
  ],
  "preRequisites": [],
  "os": {
    "packageManagers": {
      "windows": {},
      "linux": {
        "apt": {
          "command": "apt-get",
          "commands": {
            "install": {
              "command": "install",
              "nonInteractiveCommand": "install -y"
            }
          }
        }
      },
      "darwin": {}
    }
  },
  "packages": {
    "go": {
      "debian": {
        "name": "golang",
        "version": "latest",
        "source": null
        // "options": {
        //   "preferences": {
        //     "packageManager": "brew"
        //   }
        // }
      }
    }
  }
}
