{
  // Read by `envmgr dotfiles link` (https://github.com/dev-vinicius-andrade/environment-manager#dotfiles).
  // Hyprland is left out on purpose: link it by hand on a machine that runs it.
  "links": [
    { "src": ".zshenv", "dest": "~/.zshenv" },
    { "src": ".zshrc", "dest": "~/.zshrc" },
    { "src": "starship/starship.toml", "dest": "~/.config/starship.toml" },
    { "src": "nvim", "dest": "~/.config/nvim" },
    { "src": "tmux/.tmux.conf", "dest": "~/.tmux.conf" },
    { "src": "herdr", "dest": "~/.config/herdr" },
    { "src": "yazi", "dest": "~/.config/yazi" },
    { "src": "zellij", "dest": "~/.config/zellij" },
    { "src": "nushell", "dest": "~/.config/nushell" },
    { "src": "alacritty", "dest": "~/.config/alacritty" },
    { "src": "wezterm", "dest": "~/.config/wezterm" }
  ],
  "preRequisites": [],
  "os": {
    "packageManagers": {
      "windows": {},
      "linux": {
        "apt": {
          "command": "apt-get",
          "commands": {
            "install": {
              "command": "install",
              "nonInteractiveCommand": "install -y"
            }
          }
        }
      },
      "darwin": {}
    }
  },
  "packages": {
    "go": {
      "debian": {
        "name": "golang",
        "version": "latest",
        "source": null
        // "options": {
        //   "preferences": {
        //     "packageManager": "brew"
        //   }
        // }
      }
    }
  }
}
